{
  "name": "ether-state",
  "version": "0.2.3",
  "description": "Library for syncing state from contracts.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xjimmy/ether-state.git"
  },
  "author": "James Galbraith <me@0xjimmy.xyz>",
  "license": "MIT",
  "scripts": {
    "build": "bun scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src examples",
    "test": "bun test",
    "test:live": "bun test ./test/rpc.live.test.mjs ./test/viem.live.test.mjs",
    "test:package": "bun scripts/test-package.mjs",
    "bench:viem": "bun bench/viem.mjs",
    "check": "bun run typecheck && bun run lint && bun test && bun run build && bun run test:package",
    "prepack": "bun run build"
  },
  "dependencies": {
    "effect": "^4.0.0-rc.115",
    "ethers": "^6.17.0"
  },
  "devDependencies": {
    "@foundry-rs/anvil": "1.7.1",
    "@types/node": "^22.20.2",
    "eslint": "10.10.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "viem": "^2.56.5"
  },
  "packageManager": "bun@1.3.3",
  "main": "./dist/cjs/index.cjs",
  "types": "./dist/esm/index.d.ts",
  "files": [
    "/dist"
  ],
  "type": "module",
  "module": "./dist/esm/index.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/cjs/index.cjs"
      }
    },
    "./viem": {
      "import": {
        "types": "./dist/esm/viem.d.ts",
        "default": "./dist/esm/viem.js"
      },
      "require": {
        "types": "./dist/esm/viem.d.ts",
        "default": "./dist/cjs/viem.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
